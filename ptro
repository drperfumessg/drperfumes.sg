    background: #0b0b0b;
    color: white;
}
header {
    background: #000;
    padding: 25px 20px;
    text-align: center;
    border-bottom: 1px solid #292929;
}
.logo {
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 2px;
}
.logo span {
    color: #d4af37;
}
header p {
    color: #aaa;
    margin-top: 8px;
    font-size: 14px;
}
.hero {
    text-align: center;
    padding: 55px 20px;
    background: linear-gradient(135deg, #111, #050505);
}
.hero h1 {
    font-size: 38px;
    margin-bottom: 15px;
}
.hero h1 span {
    color: #d4af37;
}
.hero p {
    color: #bbb;
    max-width: 600px;
    margin: auto;
    line-height: 1.6;
}
.btn {
    display: inline-block;
    margin-top: 25px;
    padding: 13px 25px;
    background: #d4af37;
    color: #000;
    text-decoration: none;
    border-radius: 30px;
    font-weight: bold;
}
.section {
    padding: 45px 20px;
    max-width: 1200px;
    margin: auto;
}
.section h2 {
    text-align: center;
    margin-bottom: 35px;
    font-size: 28px;
}
.productos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}
.producto {
    background: #151515;
    border: 1px solid #292929;
    border-radius: 15px;
    overflow: hidden;
    transition: 0.3s;
}
.producto:hover {
    transform: translateY(-5px);
    border-color: #d4af37;
}
.foto {
    width: 100%;
    height: 250px;
    background: #222;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.foto img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}
.info {
    padding: 20px;
}
.info h3 {
    font-size: 18px;
    margin-bottom: 12px;
}
.precio {
    display: flex;
    justify-content: space-between;
    margin: 7px 0;
    color: #ccc;
}
.precio strong {
    color: #d4af37;
}
.comprar {
    display: block;
    text-align: center;
    margin-top: 15px;
    padding: 10px;
    background: #25d366;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: bold;
}
.descripcion {
    text-align: center;
    max-width: 750px;
    margin: auto;
    color: #bbb;
    line-height: 1.7;
}
footer {
    text-align: center;
    padding: 30px 20px;
    background: #000;
    color: #777;
    margin-top: 30px;
}
footer strong {
    color: #d4af37;
}
.whatsapp {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 58px;
    height: 58px;
    background: #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: white;
    font-size: 27px;
    box-shadow: 0 4px 15px #000;
}
